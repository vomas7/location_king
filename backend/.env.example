# Локальный запуск бэкенда без Docker. Скопируйте в .env.
# Конфигурация прод-контура — в .env.example в корне репозитория.

# ─── Хранилища ───────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://locationking:locationking@localhost:5432/location_king
REDIS_URL=redis://localhost:6379/0

# ─── JWT ─────────────────────────────────────────────────────────────
# Обязательная переменная: без неё приложение не стартует.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# ─── Спутниковые снимки ──────────────────────────────────────────────
# Тайлы отдаются клиенту только через прокси бэкенда, поэтому здесь —
# адрес источника, а не то, что видит браузер.
SATELLITE_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
SATELLITE_ATTRIBUTION=Esri, Maxar, Earthstar Geographics
SATELLITE_MAX_ZOOM=18
TILE_CACHE_TTL_SECONDS=604800
TILE_PREWARM=true

# ─── Приложение ──────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
DEBUG=true
