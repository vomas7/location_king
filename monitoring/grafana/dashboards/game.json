    {
      "type": "stat",
      "title": "Запросов в минуту",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(location_king_requests_total[5m])) * 60",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false
