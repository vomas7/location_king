# Конфигурация прод-контура (docker compose в корне репозитория).
# Скопируйте в .env и заполните. .env в репозиторий не коммитится.
#
# Локальная разработка настройки не требует: docker-compose.dev.yml
# поднимается командой make dev со своими значениями.

# ─── PostgreSQL ──────────────────────────────────────────────────────
POSTGRES_USER=locationking
POSTGRES_PASSWORD=
POSTGRES_DB=location_king

# ─── Redis ───────────────────────────────────────────────────────────
REDIS_PASSWORD=

# ─── JWT ─────────────────────────────────────────────────────────────
# Обязательная переменная: без неё бэкенд не стартует.
# Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# ─── Спутниковые снимки ──────────────────────────────────────────────
# Тайлы отдаются игроку только через прокси бэкенда, поэтому здесь адрес
# источника, а не то, что видит браузер. Перед сменой провайдера проверьте
# его условия использования на предмет проксирования тайлов.
SATELLITE_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
SATELLITE_ATTRIBUTION="Esri, Maxar, Earthstar Geographics"
# Заранее тянуть верхние тайлы раунда, чтобы игрок не ждал первый экран.
# Стоит лишних запросов к провайдеру: тем, кто платит за тайлы, стоит выключить.
TILE_PREWARM=true

# ─── Адрес сайта ─────────────────────────────────────────────────────
# Нужен там, где ссылка обязана быть абсолютной: canonical, og:url и
# sitemap.xml. Пусто — эти теги не появятся вовсе: неверный canonical хуже
# отсутствующего, поисковик по нему склеит не те страницы.
#
# Значение уходит в сборку фронтенда аргументом, поэтому после его смены
# нужен ./deploy.sh, а не просто перезапуск контейнеров.
SITE_URL=https://locationking.ru

# ─── Оператор сервиса ────────────────────────────────────────────────
# Кто отвечает за сайт: имя и адрес для обращений. Эти значения показываются
# в условиях использования и политике конфиденциальности — без них документы
# бесполезны, потому что непонятно, кому писать.
#
# Значения попадают в config.js, который deploy.sh собирает при каждом
# развёртывании и монтирует в nginx. Менять их можно без пересборки.
OPERATOR_NAME=
OPERATOR_EMAIL=

# ─── NGINX ───────────────────────────────────────────────────────────
# cloudflare — сайт стоит за Cloudflare, origin-сертификат в ./ssl/origin.pem
#              и ./ssl/origin.key. deploy.sh сам соберёт список сетей
#              Cloudflare и включит Authenticated Origin Pulls
# tls        — сертификаты свои: ./ssl/fullchain.pem и ./ssl/privkey.pem
# http       — TLS терминирует хостинг или балансировщик, nginx слушает 80
NGINX_PROFILE=cloudflare
