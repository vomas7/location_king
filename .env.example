# Конфигурация прод-контура (docker compose в корне репозитория).
# Скопируйте в .env и подставьте свои значения. .env в репозиторий не
# коммитится. Переменные для локального запуска бэкенда без Docker —
# в backend/.env.example.

# ─── PostgreSQL ──────────────────────────────────────────────────────
POSTGRES_USER=locationking
POSTGRES_PASSWORD=
POSTGRES_DB=location_king

# ─── Redis ───────────────────────────────────────────────────────────
REDIS_PASSWORD=

# ─── Подключения, которые читает backend/app/config.py ───────────────
# Хосты — имена сервисов из docker-compose.yml, пароли должны совпадать
# с заданными выше.
DATABASE_URL=postgresql+asyncpg://locationking:PASSWORD@postgres:5432/location_king
REDIS_URL=redis://:PASSWORD@redis:6379/0

# ─── Keycloak ────────────────────────────────────────────────────────
# Читается config.py, но к бэкенду не подключён: авторизации сейчас нет.
# Keycloak убирается целиком на этапе 4, вместе с этими переменными.
KEYCLOAK_URL=https://auth.example.com
KEYCLOAK_REALM=location-king
KEYCLOAK_CLIENT_ID=location-king-backend
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=

# ─── Спутниковые снимки ──────────────────────────────────────────────
# По умолчанию используется ESRI World Imagery, токен не нужен.
# Токен Mapbox — запасной вариант: https://account.mapbox.com/
MAPBOX_ACCESS_TOKEN=
